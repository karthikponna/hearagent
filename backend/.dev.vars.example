# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
DODO_API_KEY=...
DODO_WEBHOOK_SECRET=whsec_...
DODO_PRODUCT_ID=pdt_...
STATE_SECRET=any-long-random-string
# Set to 1 to skip OpenAI and ElevenLabs and return canned text plus a beep.
MOCK_PROVIDERS=0
