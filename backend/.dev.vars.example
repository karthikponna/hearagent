# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
# Supabase → Project Settings → API Keys → Secret keys. Server-only; never put it in the app.
SUPABASE_SECRET_KEY=sb_secret_...
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
DODO_API_KEY=...
DODO_WEBHOOK_SECRET=whsec_...
# Set to 1 to skip OpenAI and ElevenLabs and return canned text plus a beep.
MOCK_PROVIDERS=0
