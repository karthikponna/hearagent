{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearagent-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    "APP_URL_SCHEME": "hearagent",
    "OPENAI_MODEL": "gpt-5-mini",
    "ELEVENLABS_MODEL": "eleven_flash_v2_5",
    // George
    "ELEVENLABS_VOICE_ID": "JBFqnCBsd6RMkjVDRZzb",
    "DODO_ENVIRONMENT": "test_mode",
    // Public origin used for the checkout return page, e.g. https://api.hearagent.dev. Empty = request origin.
    "PUBLIC_URL": "",
    // Project URL from Supabase → Project Settings → Data API.
    "SUPABASE_URL": "https://rgxpoyfgcscwkldquhvv.supabase.co",
    // "1" returns canned text and a beep instead of calling OpenAI and ElevenLabs (local testing only).
    "MOCK_PROVIDERS": "0"
  }
}
